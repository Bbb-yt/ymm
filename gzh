        // ==================== 渲染引擎 ====================
        function escapeHtml(str) {
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        }

        function applyInlineStyles(text, style) {
            text = text.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (match, alt, url) => {
                return `<img src="${url}" alt="${escapeHtml(alt)}" style="${style.img}" />`;
            });
            text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (match, txt, url) => {
                return `<a href="${url}" style="${style.a}" target="_blank">${txt}</a>`;
            });
            text = text.replace(/\*\*([^*]+)\*\*/g, `<strong style="${style.strong}">$1</strong>`);
            text = text.replace(/\*([^*]+)\*/g, `<em style="${style.em}">$1</em>`);
            text = text.replace(/`([^`]+)`/g, `<code style="background:#f0f0f0;padding:2px 4px;border-radius:3px;font-family:monospace;">$1</code>`);
            return text;
        }

        function renderMarkdown(md, style) {
            const lines = md.split('\n');
            let html = '';
            let inList = false;
            let listType = null;
            let listContent = '';

            function closeList() {
                if (inList) {
                    if (listType === 'ul') {
                        listContent += '</ul>';
                    } else if (listType === 'ol') {
                        listContent += '</ol>';
                    }
                    html += listContent;
                    listContent = '';
                    inList = false;
                    listType = null;
                }
            }

            for (let i = 0; i < lines.length; i++) {
                const line = lines[i];
                if (/^\s*---+\s*$/.test(line)) {
                 closeList();
                    html += '<hr style="border:none;border-top:1px solid #ddd;margin:20px 0;" />';
                    continue;
                }
                let match = line.match(/^(#{1,6})\s+(.*)$/);
                if (match) {
                    closeList();
                    const level = match[1].length;
                    const text = match[2];
                    const tag = 'h' + level;
                    let styleAttr = '';
                    if (level === 1) styleAttr = style.h1;
                    else if (level === 2) styleAttr = style.h2;
                    else if (level === 3) styleAttr = style.h3;
                    else if (level >= 4) styleAttr = style.h3;
                    html += `<${tag} style="${styleAttr}">${applyInlineStyles(text, style)}</${tag}>`;
                    continue;
                }
                match = line.match(/^\>\s?(.*)$/);
                if (match) {
                    closeList();
                    const content = match[1];
                    html += `<blockquote style="${style.blockquote}">${applyInlineStyles(content, style)}</blockquote>`;
                    continue;
                }
                match = line.match(/^\s*[-*]\s+(.*)$/);
                if (match) {
                    if (!inList || listType !== 'ul') {
                        closeList();
                        inList = true;
                        listType = 'ul';
                        listContent = '<ul style="' + style.ul + '">';
                    }
                    listContent += `<li style="${style.li}">${applyInlineStyles(match[1], style)}</li>`;
                    continue;
                }
                match = line.match(/^\s*\d+\.\s+(.*)$/);
                if (match) {
                    if (!inList || listType !== 'ol') {
                        closeList();
                        inList = true;
                        listType = 'ol';
                        listContent = '<ol style="' + style.ul + '">';
                    }
                    listContent += `<li style="${style.li}">${applyInlineStyles(match[1], style)}</li>`;
                    continue;
                }
                if (line.trim() === '') {
                    closeList();
                    continue;
                }
                closeList();
                html += `<p style="${style.p}">${applyInlineStyles(line, style)}</p>`;
            }
            closeList();
            return html;
        }

        // ==================== 事件绑定 ====================

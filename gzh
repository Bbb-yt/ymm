            let chosenColor = null;
            let chosenStyle = null;
            let mods = [];

            // 检测颜色
            for (const [key, val] of Object.entries(colors)) {
                if (desc.includes(key)) {
                    chosenColor = val;
                    break;
                }
            }

            // 检测风格
            for (const [key, val] of Object.entries(styles)) {
                if (desc.includes(key)) {
                    chosenStyle = val;
                    break;
                }

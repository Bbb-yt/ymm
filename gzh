                '暗黑': { color: '#fff', bg: '#2c3e50', dark: true },
                '温馨': { color: '#8d6e63', bg: '#faf6f2' },
                '活泼': { color: '#e84393', bg: '#fce4ec' },
                '复古': { color: '#5d4037', bg: '#efebe9' },
                '现代': { color: '#212121', bg: '#f5f5f5' },
                '渐变': { gradient: true },
                '阴影': { shadow: true },

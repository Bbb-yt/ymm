            // 检测修饰
            for (const [key, val] of Object.entries(modifiers)) {
                if (desc.includes(key)) {
                    mods.push(val);
                }
            }

            // 应用颜色
            if (chosenColor) {
                style.h1 = style.h1.replace(/color:[^;]+;/, 'color:' + chosenColor + ';');
                style.h2 = style.h2.replace(/color:[^;]+;/, 'color:' + chosenColor + ';');

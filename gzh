            // 应用风格
            if (chosenStyle === 'business') {
                style.h1 += 'border-bottom:2px solid ' + (chosenColor || '#1e3c72') + ';padding-bottom:6px;';
                style.blockquote = style.blockquote.replace(/border-left:[^;]+;/, 'border-left:4px solid ' + (chosenColor || '#1e3c72') + ';');
            } else if (chosenStyle === 'formal' || chosenStyle === 'gov') {
                style.h1 += 'text-align:center;border-bottom:2px solid ' + (chosenColor || '#b71c1c') + ';padding-bottom:6px;';
                style.p += 'text-indent:2em;';
            } else if (chosenStyle === 'notice') {
                style.h1 += 'background:' + (chosenColor || '#ffebee') + ';padding:8px 15px;border-
radius:4px;color:white;';
            } else if (chosenStyle === 'literary') {
                style.h1 += 'text-align:center;';
                style.blockquote += 'font-style:italic;';
            } else if (chosenStyle === 'fancy') {
                style.h1 += 'text-shadow:1px 1px 2px rgba(0,0,0,0.2);';
                style.blockquote += 'box-shadow:0 2px 6px rgba(0,0,0,0.05);';
            }

            // 应用修饰
            mods.forEach(mod => {
                if (mod.color) {
                    style.h1 = style.h1.replace(/color:[^;]+;/, 'color:' + mod.color + ';');
                    style.strong = style.strong.replace(/color:[^;]+;/, 'color:' + mod.color + ';');
                }
                if (mod.bg) {
                    style.blockquote = style.blockquote.replace(/background:[^;]+;/, 'background:' + mod.bg + ';');
                }
                if (mod.dark) {
                    style.p = style.p.replace(/color:[^;]+;/, 'color:#ecf0f1;');
                    style.h1 = style.h1.replace(/color:[^;]+;/, 'color:#fff;');
                    style.h2 = style.h2.replace(/color:[^;]+;/, 'color:#ddd;');
                    style.h3 = style.h3.replace(/color:[^;]+;/, 'color:#ccc;');
                    style.blockquote = style.blockquote.replace(/background:[^;]+;/, 'background:#34495e;');
                    style.blockquote = style.blockquote.replace(/color:[^;]+;/, 'color:#ecf0f1;');
                }
                if (mod.shadow) {
                    style.h1 += 'text-shadow:2px 2px 4px rgba(0,0,0,0.2);';
                    style.img += 'box-shadow:0 4px 8px rgba(0,0,0,0.1);';
                }
                if (mod.gradient && chosenColor) {
                    style.h1 = style.h1.replace(/color:[^;]+;/, 'background:linear-gradient(90deg,' + chosenColor + ',#4ecdc4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;');
                }
            });

            return style;
